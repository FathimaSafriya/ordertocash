# ==============================================================================
# AI-Powered Credit Release Cockpit - Environment Configuration
# ==============================================================================

# Server Port
PORT=5000
NODE_ENV=development

# ------------------------------------------------------------------------------
# SAP S/4HANA INTEGRATION CONFIGURATION
# ------------------------------------------------------------------------------
# Mode: 'mock' (default, uses in-memory realistic SAP data) or 'sap' (connects to real SAP S/4HANA)
SAP_MODE=mock

# S/4HANA System Host & Credentials (Required only when SAP_MODE=sap)
SAP_BASE_URL=https://your-s4hana-tenant.example.com
SAP_CLIENT=100
SAP_DESTINATION=S4HANA_DESTINATION_NAME
SAP_USERNAME=
SAP_PASSWORD=
SAP_AUTH_TYPE=basic # Options: basic, oauth, apiKey
SAP_API_KEY=

# SAP OData / REST Service Endpoints
# Default standard released SAP APIs for S/4HANA Cloud / On-Premise:
# Sales Orders: /sap/opu/odata/sap/API_SALES_ORDER_SRV
# Credit Management: /sap/opu/odata/sap/API_CR_CREDIT_ACCOUNT_SRV
SAP_SALES_ORDER_ENDPOINT=/sap/opu/odata/sap/API_SALES_ORDER_SRV
SAP_CREDIT_ENDPOINT=/sap/opu/odata/sap/API_CR_CREDIT_ACCOUNT_SRV

# ------------------------------------------------------------------------------
# AI SERVICE CONFIGURATION
# ------------------------------------------------------------------------------
# AI Mode: 'mock' (uses deterministic risk scoring & rule-based grounded explanations)
#          'openai' or 'gemini' (calls LLM API with grounded customer & order data)
AI_MODE=mock

# AI Provider API Keys (Used only when AI_MODE != mock)
AI_API_KEY=
AI_MODEL=gemini-1.5-flash

# Operational Rule Thresholds
OVERDUE_RISK_THRESHOLD=100000
